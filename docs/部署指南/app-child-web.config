<?xml version="1.0" encoding="utf-8"?>
<!--
  前台 web 的 /app 子應用 web.config（反向代理到 Next standalone pm2:3000）
  ─────────────────────────────────────────────────────────────
  放置位置：/app 子應用的實體資料夾根目錄（C:\app\ReactL_IIS_Web\web.config）。
  該資料夾不放網站檔案，只放這個 web.config——把 /app/* 反向代理到本機 Next standalone
  （C:\app\ReactL_Web\server.js，pm2，port 3000）。

  前置：IIS 已裝 URL Rewrite + ARR，ARR「Enable proxy」已開、
       「Response buffer threshold (KB)」設 0（前台聊天 SSE 串流才不會卡）。

  為何用兩條規則：避免「尾斜線重導圈（ERR_TOO_MANY_REDIRECTS）」——
    Next 設 basePath '/app'，GET /app 回 200、GET /app/ 回 308（導掉尾斜線）。
    若把子應用根反代成 .../app/（多尾斜線），Next 會 308 導回 /app，
    瀏覽器再經代理又變 /app/ → 無限圈。
    故「根」單獨反代成 .../app（不加斜線），其餘才補 /app/{R:1}。
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 子應用根（/app 或 /app/）→ 反代到 Next 的 /app，不加尾斜線 -->
        <rule name="app-root" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="http://localhost:3000/app" />
        </rule>
        <!-- 其餘 /app/* → 反代，補回 /app 前綴（query string 預設會帶上）-->
        <rule name="app-rest" stopProcessing="true">
          <match url="(.+)" />
          <action type="Rewrite" url="http://localhost:3000/app/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
