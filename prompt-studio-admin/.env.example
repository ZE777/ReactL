# 複製此檔為 .env.local 並填入實際值
# -----------------------------------------------
# 後端 API 位址（含版本前綴）
VITE_API_BASE_URL=https://localhost:44345/api/v1

# 後台前端完整網址，dev server port 從此處解析
VITE_UI_URL=http://localhost:5173

# 對外公開的前台網址，用於組合存取碼邀請連結（${VITE_PUBLIC_WEB_URL}/chat?code=...）
VITE_PUBLIC_WEB_URL=http://localhost:3000
