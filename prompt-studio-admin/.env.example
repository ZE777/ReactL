# 複製此檔為 .env.local 並填入實際值
# -----------------------------------------------
# 後端 API 位址（含版本前綴）
VITE_API_BASE_URL=https://localhost:44345/api/v1

# 後台前端完整網址，dev server port 從此處解析（admin 已設 Vite base:'/admin/'）
VITE_UI_URL=http://localhost:5173

# 前台 web 對外網址，用於組裝「複製給外部開啟」的連結（必須是對外絕對網址）：
#   (1) 存取碼邀請連結   ${VITE_PUBLIC_WEB_URL}/chat?code=...   （AccessCodesPage）
#   (2) 對話公開分享連結 ${VITE_PUBLIC_WEB_URL}/share/<slug>    （ConversationsPage）
# 注意：web 設了 Next basePath '/app'，故對外網址含 /app（dev 為 http://localhost:3000/app）
VITE_PUBLIC_WEB_URL=http://localhost:3000/app

# ─────────────────────────────────────────────────────────────────────
# ngrok 對外發布範例：單一固定網址 + 子應用路徑分流
#   /api   → 後端（根站台直接託管）
#   /admin → admin 子應用（靜態，Vite base:'/admin/'）
#   /app   → web 子應用（反向代理 Next，Next basePath:'/app'）
# VITE_API_BASE_URL=https://your-name.ngrok-free.app/api/v1
# VITE_UI_URL=https://your-name.ngrok-free.app/admin
# VITE_PUBLIC_WEB_URL=https://your-name.ngrok-free.app/app
