<?xml version="1.0" encoding="utf-8"?>
<!--
  後台 admin（Vite SPA）的 IIS 靜態託管設定。
  放在 public/ 內，Vite build 時會自動複製到 dist/ 根目錄。
  作為 gateway 站台底下 /admin 子應用的設定：
    - SPA fallback：找不到實體檔/資料夾時，一律回 index.html，交給前端 React Router 處理路由
  注意：admin 已設 Vite base:'/admin/' 與 Router basename，故資源與路由都掛在 /admin 底下。
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="spa-fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <!-- 確保常見靜態資源 MIME 正確（部分精簡版 Windows 缺這些）-->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
  </system.webServer>
</configuration>
